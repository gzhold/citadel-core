# =====================================================================
# Citadel 本地开发环境变量模板
# 用法：cp .env.example .env （.env 已被 gitignore，绝不入库）
# 本地开发默认连接 Neon dev 分支（区域建议 ap-southeast-1，延迟更低）
# =====================================================================

# ---- 数据库（Neon 控制台 -> Project Dashboard -> Connection Details）
# 注意选择 Pooled connection（走 Neon 内置 PgBouncer，生产必用）
DATABASE_URL=jdbc:postgresql://ep-xxxxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=change-me

# ---- 安全（生成方式：openssl rand -base64 48）
JWT_SECRET=change-me-base64-secret-at-least-32-bytes

# ---- CORS 允许来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- 前端 API 地址（浏览器可达地址；compose 与本地开发均为宿主机 8080）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
