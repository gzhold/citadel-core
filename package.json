{
  "name": "citadel-core",
  "version": "0.1.0",
  "private": true,
  "description": "Citadel — B2B 多租户团队协作平台（个人作品集项目，与任何同名公司/组织无关）",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev:web": "pnpm --filter @citadel/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "prettier": "^3.5.3"
  }
}
